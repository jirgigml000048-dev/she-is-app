# ──────────────────────────────────────────────────────────────
# 女也 She Is — Environment Variables
# Copy this file to .env and fill in real values before deploying.
# ──────────────────────────────────────────────────────────────

# ── Netlify Functions ────────────────────────────────────────
# Used by: netlify/functions/narrative.js, netlify/functions/chat.js
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Supabase (client-side, already in assets/auth.js) ───────
# These are public/anon keys, safe to expose in frontend code.
# SUPABASE_URL=https://xagmrtiajoyznquzehqd.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...

# ── Supabase Edge Functions (server-side secrets) ────────────
# Set these in: Supabase Dashboard → Project → Edge Functions → Secrets
# Or via: supabase secrets set KEY=VALUE

# Supabase service role key (NOT the anon key)
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# CORS whitelist (comma-separated origins, e.g. https://she-is-app.netlify.app)
# Leave empty to allow all origins (not recommended for production)
ALLOWED_ORIGINS=https://she-is-app.netlify.app

# ── Tencent Cloud SMS (for phone OTP login) ─────────────────
# Used by: supabase/functions/send-sms/index.ts
# Get from: https://console.cloud.tencent.com/smsv2
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_TEMPLATE_ID=

# ── SMS Auth ────────────────────────────────────────────────
# Used by: supabase/functions/verify-sms/index.ts
# A secret string used to derive user passwords for phone-based accounts.
# Generate a random string, e.g.: openssl rand -hex 32
SMS_USER_SECRET=

# ── ElevenLabs (voice generation, used by gen-008.mjs) ──────
# Only needed if regenerating story audio files.
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
